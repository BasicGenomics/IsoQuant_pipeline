#!/usr/bin/env python3

from argparse import ArgumentParser
from datetime import datetime, timezone
import json
import os
import sys

with open(os.path.join(os.path.dirname(os.path.abspath(__file__)), "VERSION")) as _vf:
    _tokens = _vf.read().strip().split()
    __version__ = _tokens[1]            
    _codename   = " ".join(_tokens[2:]) or ""

sys.path.insert(0, os.path.join(os.path.dirname(os.path.abspath(__file__)), "workflow", "scripts"))
from bc_banner import build_banner

logo = build_banner(__version__, _codename)

if __name__ == '__main__':

    print(logo)
    sys.stdout.flush()

    aparser = ArgumentParser()

    aparser.add_argument('-c', '--config',
                         help='Path to config yaml file', default="config/config.yaml")
    aparser.add_argument('-t', '--threads', default=30, type=int,
                         help='Number of threads to allocate for analysis')
    aparser.add_argument('--verbose', action='store_true',
                         help='Verbose output')
    aparser.add_argument('--dry-run', action='store_true',
                         help='Perform a dry run without executing commands')

    args, unknown = aparser.parse_known_args()

    persisted = os.path.join('results', 'isoquant', '.snakemake')
    os.makedirs(persisted, exist_ok=True)
    if not os.path.islink('.snakemake') and not os.path.exists('.snakemake'):
        os.symlink(persisted, '.snakemake')

    config_args = ''
    if args.config != '':
        config_args += '--configfile {} '.format(args.config)
    config_args += '--config threads={} '.format(args.threads)

    snakemake_cmd = 'snakemake -j {} --rerun-incomplete {}'.format(args.threads, config_args)
    if not args.verbose:
        snakemake_cmd += '-q all '
    if args.dry_run:
        snakemake_cmd += '--dry-run -p'
    if unknown:
        snakemake_cmd += " ".join(unknown) + " "

    os.makedirs(os.path.join('results', 'isoquant', 'logs'), exist_ok=True)
    manifest = {
        'version': __version__,
        'timestamp': datetime.now(timezone.utc).isoformat(),
        'snakemake_cmd': snakemake_cmd.strip(),
        'threads': args.threads,
        'config': args.config,
        'extra_args': unknown,
    }
    with open(os.path.join('results', 'isoquant', 'logs', 'run_manifest.json'), 'w') as _mf:
        json.dump(manifest, _mf, indent=2)

    if not args.dry_run:
        unlock_cmd = 'snakemake -j {} {}--unlock'.format(args.threads, config_args)
        if not args.verbose:
            unlock_cmd += ' -q all'
        os.system(unlock_cmd)

    os.system(snakemake_cmd)
