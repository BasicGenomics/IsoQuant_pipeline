# Main entrypoint of the workflow. 
# Please follow the best practices: 
# https://snakemake.readthedocs.io/en/stable/snakefiles/best_practices.html,
# in particular regarding the standardized folder structure mentioned there. 

from snakemake.utils import min_version
import time as _bc_time
import sys
import os
min_version("6.7")

configfile: "config/config.yaml"

if 'resource_dir' not in config:
    config['resource_dir'] = '/usr/local/app/resources/'
else:
    if config['resource_dir'] == '':
        config['resource_dir'] = '/usr/local/app/resources/'

config['resource_dir'] = config['resource_dir'].rstrip('/')

if "full_length_only" not in config:
    config["full_length_only"] = False

if "collapse_annotation" not in config:
    config["collapse_annotation"] = True

if "collapse_mode" not in config:
    config["collapse_mode"] = "cds"

if "collapse_representative" not in config:
    config["collapse_representative"] = "canonical"

if "basecode_max_gap" not in config:
    config["basecode_max_gap"] = 550

if "basecode_correct" not in config:
    config["basecode_correct"] = False

if "basecode_keep_nonunique" not in config:
    config["basecode_keep_nonunique"] = True

if "basecode_no_context_resolve" not in config:
    config["basecode_no_context_resolve"] = False

if "basecode_end_resolve" not in config:
    config["basecode_end_resolve"] = True

if "data_type" not in config:
    config["data_type"] = "pacbio_ccs"

if "matching_strategy" not in config:
    config["matching_strategy"] = "precise"

if "delta" not in config:
    config["delta"] = "auto"

if "transcript_quantification" not in config:
    config["transcript_quantification"] = "unique_only"

if "gene_quantification" not in config:
    config["gene_quantification"] = "unique_splicing_consistent"

if "model_construction_strategy" not in config:
    config["model_construction_strategy"] = "default_pacbio"

if "polya_requirement" not in config:
    config["polya_requirement"] = "auto"

if "read_group" not in config:
    config["read_group"] = "tag:SM"

if "annotate_bam" not in config:
    config["annotate_bam"] = False

if "duplicate_mode" not in config:
    config["duplicate_mode"] = "all"

GROUP_TOKEN = config["read_group"].replace(":", "_")

REF = "{resource_dir}/genome_references/{reference}/reference.fa".format(resource_dir = config["resource_dir"], reference = config["reference"])
GFF = "{resource_dir}/genome_references/{reference}/geneannotations".format(resource_dir=config["resource_dir"], reference = config["reference"])
COLLAPSED = "{}_collapsed_{}_{}.gff3".format(GFF, config["collapse_mode"], config["collapse_representative"])
ANNOTATION = COLLAPSED if config["collapse_annotation"] else "{}.gff3".format(GFF)
GENEDB = "results/isoquant/{}.db".format(os.path.splitext(os.path.basename(ANNOTATION))[0])
READ_ASSIGNMENTS = "results/isoquant/{name}/{name}.read_assignments.tsv.gz".format(name=config["name"])
ANNOTATED_BAM = "results/isoquant/{name}.annotated.bam".format(name=config["name"])
VARIANT_SUPPORT = "results/isoquant/{name}/{name}.variant_support.per_variant.tsv".format(name=config["name"])

include: "rules/run_isoquant.smk"

onstart:
    config['_bc_start'] = _bc_time.time()
    print("▶ BaseCode IsoQuant Pipeline starting", file=sys.stdout, flush=True)
    print(f"  Run ID: {config['name']}  (BaseCode mode, max_gap={config['basecode_max_gap']})", file=sys.stdout, flush=True)

onsuccess:
    elapsed = int(_bc_time.time() - config.get('_bc_start', _bc_time.time()))
    h, rem = divmod(elapsed, 3600)
    m, s = divmod(rem, 60)
    elapsed_str = f"{h}h {m}m {s}s" if h else (f"{m}m {s}s" if m else f"{s}s")
    print(f"✓ BaseCode IsoQuant Pipeline completed in {elapsed_str}", file=sys.stdout, flush=True)

onerror:
    print("✗ BaseCode IsoQuant Pipeline failed", file=sys.stdout, flush=True)
    print("  See results/isoquant/.snakemake/log/ for details", file=sys.stdout, flush=True)

rule all:
    input: ["results/isoquant/mudata/{name}_counts.h5mu".format(name=config["name"]), VARIANT_SUPPORT] + ([ANNOTATED_BAM + ".bai"] if config["annotate_bam"] else [])